# Dozzle + Traefik + Let's Encrypt — Environment Variables
# Copy this file to `.env` and fill in each value before `docker compose up`.
# `.env` is gitignored — never commit real credential values.
#
# Image versions are NOT set here. The tested tag + sha256 digest for every
# image lives in the compose file's `x-images` block, so `git pull` delivers
# the version combination this repository has tested. To pin a different
# version yourself, uncomment and set:
# DOZZLE_IMAGE_TAG=amir20/dozzle:v10.10.0@sha256:…

# ──────────────────────────────────────────────────────────────────────────────
# Traefik reverse proxy
# ──────────────────────────────────────────────────────────────────────────────

# Email address for Let's Encrypt renewal notices. REQUIRED.
TRAEFIK_ACME_EMAIL=admin@example.com

# Hostname for the Traefik dashboard (basic-auth protected). REQUIRED.
TRAEFIK_HOSTNAME=traefik.dozzle.example.com

# Basic Authentication for the Traefik dashboard.
# Format: USERNAME:BCRYPT_HASH (with $ characters doubled to $$ for compose)
#     htpasswd -nbB traefikadmin YOUR_STRONG_PASSWORD | sed 's/\$/\$\$/g'
# REQUIRED — do not ship production without changing this.
TRAEFIK_BASIC_AUTH=change_me_generate_with_htpasswd_and_replace_this_string

# Log level: DEBUG, INFO, WARN, ERROR. Default: WARN.
# TRAEFIK_LOG_LEVEL=WARN

# ──────────────────────────────────────────────────────────────────────────────
# Dozzle
# ──────────────────────────────────────────────────────────────────────────────

# Public hostname. Must resolve to this server's public IP for the
# Let's Encrypt TLS-ALPN challenge. REQUIRED.
DOZZLE_HOSTNAME=logs.example.com

# ──────────────────────────────────────────────────────────────────────────────
# The account. REQUIRED — the stack refuses to start without one.
# ──────────────────────────────────────────────────────────────────────────────
#
# Dozzle's own default is DOZZLE_AUTH_PROVIDER=none, and none means an
# unauthenticated reader of every log line on this host: connection strings,
# tokens printed at startup, the bodies of failed requests. This template will
# not start that way. Generate the hash:
#
#   docker run --rm amir20/dozzle:v10.10.0 generate \
#     --name 'Your Name' --email you@example.com \
#     --password 'YOUR_STRONG_PASSWORD' yourusername
#
# Copy the value from its `password:` line into DOZZLE_ADMIN_PASSWORD_HASH,
# DOUBLING EVERY $ TO $$ so Compose does not try to interpolate it — the same
# rule as TRAEFIK_BASIC_AUTH above. A hash pasted without doubling produces a
# user whose password nothing matches.
#
# Prefer to manage the file yourself? Put a users.yml in the `dozzle-data`
# volume at /data/users.yml and leave these two blank; the init container finds
# it and leaves it alone. That is the way to have more than one account.
DOZZLE_ADMIN_USERNAME=admin
DOZZLE_ADMIN_PASSWORD_HASH=change_me_run_the_generate_command_above

# Shown on the account, nothing more.
# DOZZLE_ADMIN_EMAIL=admin@example.com
# DOZZLE_ADMIN_NAME=Administrator

# How long a signed-in session lasts. Dozzle's own default is a session cookie
# that dies with the browser: correct, and irritating on a phone at two in the
# morning, which is when this is actually used. Set to `session` to get the
# stricter behaviour back.
# DOZZLE_AUTH_TTL=48h

# Set to `none` to turn authentication off entirely. Read the paragraph above
# before you do. With anything other than `simple`, the init container stops
# managing the user file and the decision is yours.
# DOZZLE_AUTH_PROVIDER=simple

# ──────────────────────────────────────────────────────────────────────────────
# Container actions (only with container-actions.override.yml)
# ──────────────────────────────────────────────────────────────────────────────
#
# Restart and stop buttons in the log view. Both halves — Dozzle's setting and
# the proxy's POST permission — live in that override file, because setting one
# without the other silently does nothing. Read it before using it.
#
# There is no override for DOZZLE_ENABLE_SHELL, on purpose. A restart button is
# a restart button; a browser shell inside the container holding your database
# credentials is arbitrary command execution on your host. You have SSH.

# The name shown in the interface when you run more than one Dozzle.
# DOZZLE_DISPLAY_NAME=docker

# Timezone for timestamps in the interface.
# DOZZLE_TZ=Etc/UTC

# Dozzle's own log level: debug, info, warn, error.
# DOZZLE_LOG_LEVEL=info

# A live log tail is a response that never ends. The idle timeout is what would
# close it during a quiet hour, so it is an hour rather than Traefik's 180
# seconds.
# DOZZLE_STREAM_TIMEOUT=0s
# DOZZLE_IDLE_TIMEOUT=3600s

# ──────────────────────────────────────────────────────────────────────────────
# Backups (defaults shown; override only to tune)
# ──────────────────────────────────────────────────────────────────────────────
#
# Dozzle stores no logs — it streams them from the daemon on every page load —
# so /data is small and entirely irreplaceable: the user file, and each user's
# interface settings.

# BACKUP_INIT_SLEEP=30m
# BACKUP_INTERVAL=24h
# DATA_BACKUP_PRUNE_DAYS=7
# DATA_BACKUPS_PATH=/srv/dozzle-data/backups
# DATA_PATH=/data
# DATA_BACKUP_NAME=dozzle-data-backup

# Resource limits (defaults shown). Dozzle streams rather than stores, so this
# stays small even with many containers.
# DOZZLE_MEMORY_LIMIT=256m
# DOZZLE_CPU_LIMIT=1.0
# DOZZLE_MEMORY_RESERVATION=32m
# DOZZLE_CPU_RESERVATION=0.1
# DOZZLE_DOCKERPROXY_MEMORY_LIMIT=64m
# DOZZLE_DOCKERPROXY_CPU_LIMIT=0.5
# DOZZLE_DOCKERPROXY_MEMORY_RESERVATION=16m
# DOZZLE_DOCKERPROXY_CPU_RESERVATION=0.1
# DOZZLE_INIT_MEMORY_LIMIT=64m
# DOZZLE_INIT_CPU_LIMIT=0.5
# DOZZLE_INIT_MEMORY_RESERVATION=8m
# DOZZLE_INIT_CPU_RESERVATION=0.1
# TRAEFIK_MEMORY_LIMIT=256m
# TRAEFIK_CPU_LIMIT=0.5
# TRAEFIK_MEMORY_RESERVATION=64m
# TRAEFIK_CPU_RESERVATION=0.1
# DOZZLE_BACKUPS_MEMORY_LIMIT=256m
# DOZZLE_BACKUPS_CPU_LIMIT=0.5
# DOZZLE_BACKUPS_MEMORY_RESERVATION=16m
# DOZZLE_BACKUPS_CPU_RESERVATION=0.1

# How long docker waits before SIGKILL.
# DOZZLE_STOP_GRACE_PERIOD=60s

# Image versions. Every image is pinned by digest inside the compose file
# (x-images block); set the matching variable here to run a different version
# of that one image while every other pin stays as tested. Needs Docker
# Compose v2.5 or newer (2022).
# TRAEFIK_IMAGE_VERSION=3.7
# DOZZLE_IMAGE_VERSION=v10.10.0
# DOZZLE_DOCKERPROXY_IMAGE_VERSION=v0.5.0
# DOZZLE_BACKUPS_IMAGE_VERSION=3.22
